# Database Connection
# For PostgreSQL (Production): postgresql+psycopg2://postgres:postgres@localhost:5432/ambulance_tracker
# For Local Quickstart / SQLite Fallback: sqlite:///./ambulance_tracker.db
DATABASE_URL=sqlite:///./ambulance_tracker.db

# JWT Security Secrets
JWT_SECRET_KEY=emergency-ambulance-tracker-production-secret-key-32bytes!
JWT_REFRESH_SECRET=emergency-ambulance-tracker-refresh-secret-key-32bytes!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Map API Key
MAP_API_KEY=osm_default_key

# Cross-Origin Resource Sharing (CORS)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Environment Mode
ENVIRONMENT=development
